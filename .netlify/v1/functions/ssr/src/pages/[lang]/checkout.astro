---
import Layout from '../../layouts/Layout.astro';
import { getShippingRepository } from '../../lib/services';
import type { Locale } from '../../i18n';
import { locales, t } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const locale = lang;

const shippingRepo = await getShippingRepository();
const shipping = await shippingRepo.getAllRates();
---

<Layout locale={locale} title={`${t(locale, 'checkout.title')} - nisa`}>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <h1 class="text-4xl font-medium text-center mb-2">{t(locale, 'checkout.title')}</h1>
        <p class="text-center text-[#6B7B8C] dark:text-[#94a3b8] mb-12">{t(locale, 'checkout.subtitle')}</p>
        <form id="checkout-form" action="https://formspree.io/f/mwprdnqb" method="POST" class="flex flex-col-reverse lg:flex-row gap-12">
            <div class="w-full lg:w-3/5">
                <div class="space-y-8">
                    <div>
                        <h2 class="text-2xl font-medium mb-4">{t(locale, 'checkout.contactInfo')}</h2>
                        <input type="email" name="email" placeholder={t(locale, 'checkout.email')} class="form-input" required>
                        <input type="tel" name="phoneNumber" placeholder={t(locale, 'checkout.phone')} class="form-input mt-4" required>
                    </div>
                    <div>
                        <h2 class="text-2xl font-medium mb-4">{t(locale, 'checkout.shippingAddress')}</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <input type="text" name="fullName" placeholder={t(locale, 'checkout.fullName')} class="form-input sm:col-span-2" required>
                            <input type="text" name="streetAddress" placeholder={t(locale, 'checkout.streetAddress')} class="form-input sm:col-span-2" required>
                            <input type="text" name="apartment" placeholder={t(locale, 'checkout.apartment')} class="form-input sm:col-span-2">
                            <input type="text" name="city" placeholder={t(locale, 'checkout.city')} class="form-input" required>
                            <select name="governorate" class="form-input" required>
                                <option disabled selected value="">{t(locale, 'checkout.governorate')}</option>
                                {shipping.map(s => <option value={s.city}>{s.city}</option>)}
                            </select>
                            <textarea name="deliveryInstructions" placeholder={t(locale, 'checkout.deliveryInstructions')} rows="3" class="form-input sm:col-span-2"></textarea>
                        </div>
                    </div>
                    <input type="hidden" name="orderSummary" id="order-summary-input">
                    <input type="hidden" name="orderTotal" id="order-total-input">
                    <input type="hidden" name="itemsJson" id="items-json-input">
                    <input type="hidden" name="_next" value={`/${locale}/thank-you/`}>
                </div>
            </div>
            <div class="w-full lg:w-2/5">
                <div class="border border-[#D4E4E8] dark:border-[#1b456b] bg-white/50 dark:bg-[#0e2537]/50 rounded-lg p-6 sticky top-24">
                    <h2 class="text-2xl font-medium mb-6">{t(locale, 'checkout.orderSummary')}</h2>
                    <div id="checkout-items" class="space-y-4 max-h-64 overflow-y-auto mb-6 pr-2"></div>
                    <div class="space-y-2 border-t border-[#D4E4E8] dark:border-[#1b456b] pt-4">
                        <div class="flex justify-between text-[#6B7B8C] dark:text-[#94a3b8]"><span>{t(locale, 'checkout.subtotal')}</span><span id="checkout-subtotal"></span></div>
                        <div id="checkout-savings-container" class="flex justify-between text-red-500" style="display: none;"><span>{t(locale, 'checkout.savings')}</span><span id="checkout-savings"></span></div>
                        <div class="flex justify-between text-[#6B7B8C] dark:text-[#94a3b8]"><span>{t(locale, 'checkout.shipping')}</span><span id="checkout-shipping"></span></div>
                        <div class="flex justify-between font-bold text-lg border-t border-[#D4E4E8] dark:border-[#1b456b] pt-2 mt-2"><span>{t(locale, 'checkout.total')}</span><span id="checkout-total"></span></div>
                    </div>
                    <button type="submit" class="btn-primary w-full mt-6">{t(locale, 'checkout.placeOrder')}</button>
                </div>
            </div>
        </form>
    </div>
</Layout>

<style>
.form-input {
  border: 1px solid #D4E4E8;
  background: #FFFFFF;
  padding: 0.75rem 1rem;
  border-radius: 6px;
  font-size: 16px;
  width: 100%;
  transition: border-color 0.2s ease;
}

:global(.dark) .form-input {
  border-color: #1b456b;
  background: #0e2537;
  color: #e2e8f0;
}

.form-input:focus {
  border-color: #204566;
  outline: none;
  box-shadow: 0 0 0 3px rgba(32, 69, 102, 0.1);
}

:global(.dark) .form-input:focus {
  border-color: #3182ce;
  box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.1);
}

.btn-primary {
    background-color: #204566;
    color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 6px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 0.5px;
}

:global(.dark) .btn-primary {
    background-color: #3182ce;
}

.btn-primary:hover:not(:disabled) {
    background-color: #163554;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(32, 69, 102, 0.3);
}

:global(.dark) .btn-primary:hover:not(:disabled) {
    background-color: #266395;
    box-shadow: 0 4px 12px rgba(49, 130, 206, 0.3);
}
</style>