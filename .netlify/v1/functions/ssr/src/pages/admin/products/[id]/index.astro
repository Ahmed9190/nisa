---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ProductForm from '../../../../components/admin/ProductForm.astro';
import { productStore } from '../../../../lib/product-store';

const { id } = Astro.params;
const product = await productStore.getById(id || '');

if (!product) {
  return Astro.redirect('/admin/products/');
}
---

<AdminLayout title={`Edit — ${product.name}`} active="products">
  <ProductForm product={product} action="edit" />
</AdminLayout>
